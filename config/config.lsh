# If we have eza, set up ls aliases.
if $(which eza).code == 0 {
    alias set ls "eza --icons"
    alias set la "eza --icons --all"
    alias set ll "eza --icons --long"
} else {
    alias set ls "ls --color=auto -F"
    alias set la "ls -a"
    alias set ll "ls -l"
}

# Autocomplete dropdown nerd icons (requires a Nerd Font):
$options.nerd_icons = true

$prompt.before = () => {
    let git_info = ""

    if $(git rev-parse --is-inside-work-tree).code == 0 {
        let branch =  $(git branch --show-current | tr -d '\n').out
        let ahead_num = $(git status --porcelain --branch | awk 'NR==1{if(match($0,/ahead [0-9]+/)){printf substr($0,RSTART+6,RLENGTH-6)}else{printf 0}}').out
        let changes_num = $(git status --porcelain | awk 'END{printf NR}').out

        $git_info = $palette.reset + $palette.green + $branch

        if $ahead_num != 0 {
            let ahead = $palette.cyan + " ↑" + $ahead_num
            $git_info = $git_info + $ahead
        }

        if $changes_num != 0 {
            let changes = $palette.yellow + " ~" + $changes_num
            $git_info = $git_info + $changes
        }
    }

    echo $palette.bold $palette.blue
    echo $(fmt-cwd $PWD).out $git_info
}

$prompt.text = $palette.bright_magenta + "$ " + $palette.reset
