# If we have eza, set up ls aliases.
if $(which eza).code == 0 {
    alias set ls "eza --icons"
    alias set la "eza --icons --all"
    alias set ll "eza --icons --long"
} else {
    alias set ls "ls --color=auto -F"
    alias set la "ls -a"
    alias set ll "ls -l"
}

# Autocomplete dropdown nerd icons (requires a Nerd Font):
$options.nerd_icons = true

# Load prompt plugins:
# Plugins can be loaded via `import(...)` which returns an object containing
# the plugin's exported methods and properties.
let git_prompt = import("git-prompt")

# Prompt configuration:
# $prompt.segments defines the prompt segments in order.
# Segments can be direct strings (e.g. "\n" or styled text) or functions (e.g. fmt_cwd or imported plugin methods).
$prompt.segments = [
    "\n",
    () => { return $palette.bright_blue + fmt_cwd() + $palette.reset },
    $git_prompt.git,
    "\n",
    $palette.bright_magenta + "❯ " + $palette.reset
]

# Separator placed between adjacent segments on the same line:
$prompt.separator = " "

# Custom segments can also be functions:
# let time_segment = () => {
#     return $palette.dim + $(date +%H:%M).out.trim()
# }
# $prompt.segments.push(time_segment)
