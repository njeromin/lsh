declare -a pkgsHostTarget=('/nix/store/rk7b4ldkp4ssblpsa1x56kl8xf94kd1a-alejandra-4.0.0' '/nix/store/wdds5a9jax6zwj7wxqwqqp9dr28apr4q-file-5.45-dev' '/nix/store/vi7ya34k19nid2m0dmkljqip5572g0bi-file-5.45' '/nix/store/912hlbqiabfk5xy0ajla6z9dwzlwkn87-curl-8.14.1-dev' '/nix/store/lnab2vg7mcwddh63rimw1vh82nplzsxj-brotli-1.1.0-dev' '/nix/store/csa88p9sbvp9hidfq0dpl23sshalmx2c-brotli-1.1.0-lib' '/nix/store/a8s3qf5ydqbpqcshg1dgga9lag3xgbbp-brotli-1.1.0' '/nix/store/7ib902igi2hp3ahavxgidf4mcs5kak4z-krb5-1.21.3-dev' '/nix/store/w48pb5q63m9qdwh8520jpwh57blbiw88-krb5-1.21.3-lib' '/nix/store/2biz75az2fjs9396fjpizhj9a3p58g0r-krb5-1.21.3' '/nix/store/0w81d33nzdh9l1nkq6i5nymmw59a80aw-nghttp2-1.65.0-dev' '/nix/store/qv68pw71ffk2075fgk84h338lpaxnj5w-nghttp2-1.65.0-lib' '/nix/store/zcz7h88rnq340a7z6xfpn8cx5kxcnvnv-nghttp2-1.65.0' '/nix/store/aja1rcdgq8ifyh580pr8v01apsx5qfg6-libidn2-2.3.8-dev' '/nix/store/37sfyj1yqhlxhb0dy5fx3ahww7w65n8h-libidn2-2.3.8-bin' '/nix/store/v9rj8vr6q5j3kr9nmdwhc3mi7cg55xcs-libidn2-2.3.8' '/nix/store/b97gjl5zygaf6vzxsa1lf7jih8q4xi00-openssl-3.5.1-dev' '/nix/store/vwggl55yh9lba643r5avc78n7cmmbi2a-openssl-3.5.1-bin' '/nix/store/lyl9yxxz8a3mlaxvm0jln6mglpbf2fha-openssl-3.5.1' '/nix/store/xgbgkpkc5f588dyj9dfrqkx493in3jww-libpsl-0.21.5-dev' '/nix/store/6ljvcjl7i3j8lcm8qakxk1gnrx5wgpam-publicsuffix-list-0-unstable-2025-06-10' '/nix/store/marn1vzlxpfkk51zjifnlq9l10kvp8xb-libpsl-0.21.5' '/nix/store/bgivy4c6dqfxrkj14hr26zqr1g2g8xhi-libssh2-1.11.1-dev' '/nix/store/sfpj91cxjs6i50ajqk04qzlhq9j324a3-libssh2-1.11.1' '/nix/store/qjh11kgxv245166f27017hwx2fvmwh8p-zlib-1.3.1-dev' '/nix/store/97jdzvwjgwy2g4xcijimadl0vpj6laqh-zlib-1.3.1' '/nix/store/6rdhi9vyk3h67nhkwl0n7q0b6hl3xiza-zstd-1.5.7-dev' '/nix/store/g6kx2793pvvcw812n084d5rhz8l0y1nl-zstd-1.5.7-bin' '/nix/store/s77wpgad8w4yydm9qzb6prm7g8fg23z3-zstd-1.5.7' '/nix/store/z1l1b9bdzk6yspdf53z90n2dv311g1r6-curl-8.14.1-bin' '/nix/store/95iy4kvy1xllg2fpb14dhw4m3ff3l0f0-curl-8.14.1' '/nix/store/9yh9ak97gn659bk4d3n411fx6c0ng7s2-python3-3.13.5' )
